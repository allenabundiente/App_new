# ── HulogTrack — app/server environment ───────────────────────────────
# Copy this file to `.env` in the repo root and paste your PayPal Sandbox
# keys. `.env` is git-ignored; never commit real keys.
#
# The API reads this file automatically (server/src/config.ts). Keep the
# database connection string in server/.env — see server/.env.example.

# PayPal REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# The secret is used by the server only; it is never sent to the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the same PayPal app → Webhooks. Create a webhook pointing at
# https://<your-api>/api/payments/paypal/webhook and subscribe to
# CHECKOUT.ORDER.APPROVED, CHECKOUT.ORDER.COMPLETED,
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.PENDING and
# PAYMENT.CAPTURE.DENIED. Without this id the webhook returns 503.
PAYPAL_WEBHOOK_ID=
# "sandbox" or "live". Use live only when you are ready to take real money.
PAYPAL_MODE=sandbox
# Currency charged by PayPal. Must match a currency your PayPal account accepts.
PAYPAL_CURRENCY=PHP

# Where PayPal sends the browser after the buyer approves or cancels.
# These must be public http(s) URLs. The defaults work for local development
# against http://localhost:4000; on a phone, point them at your deployed API
# (for example https://your-api.onrender.com/paypal/return).
PAYPAL_RETURN_URL=http://localhost:4000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:4000/paypal/cancel

# Public base URL of the API. Used to build the default return/cancel URLs
# above when you leave them out.
APP_BASE_URL=http://localhost:4000
