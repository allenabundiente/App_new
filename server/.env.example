# ── HulogTrack server environment ─────────────────────────────────
# Copy to .env and fill in. Never commit .env!

# Postgres connection string.
#   Free options (see README.md → Deploy):
#   • Neon:   postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   • Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:pass@localhost:5432/hulogtrack

# Port the API listens on (Render injects PORT automatically).
# Microservice entries use their own defaults: auth=4001, core=4002,
# engagement=4003 (see docker-compose.yml — normally you don't set these
# by hand; the gateway routes to them).
PORT=4000

# Comma-separated origins allowed to call the API (the RN app needs none —
# native fetch has no CORS; this matters for the web dashboard).
CORS_ORIGINS=*

# Secret used to HMAC-sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me-to-a-long-random-string

# Seed the demo accounts on first boot (admin@hulog.ph etc).
SEED_ON_BOOT=1

# ── Due reminders & keep-alive ────────────────────────────────────
# Shared secret guarding POST /api/cron/reminders. The keep-alive workflow
# (or any uptime monitor) sends it as the header `x-cron-secret`. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=change-me-to-a-long-random-string

# How often the in-process scheduler scans for due reminders (minutes).
REMINDER_INTERVAL_MIN=15

# Set to 1 to disable the in-process scheduler (scan only via the cron endpoint).
DISABLE_REMINDER_SCHEDULE=0
