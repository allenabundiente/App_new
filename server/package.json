{
  "name": "hulogtrack-server",
  "version": "0.1.0",
  "private": true,
  "description": "HulogTrack API — Express + Postgres. Free-tier friendly (Neon/Supabase DB, Render/Vercel hosting).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:migrate": "tsx src/entries/migrate.ts",
    "dev:auth": "tsx watch src/entries/auth.ts",
    "dev:core": "tsx watch src/entries/core.ts",
    "dev:engagement": "tsx watch src/entries/engagement.ts",
    "dev:memory": "tsx watch src/entries/dev-memory.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:migrate": "node dist/entries/migrate.js",
    "start:auth": "node dist/entries/auth.js",
    "start:core": "node dist/entries/core.js",
    "start:engagement": "node dist/entries/engagement.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
