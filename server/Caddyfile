:8080 {
	@auth {
		path /api/auth/* /api/me /api/users*
	}
	handle @auth {
		reverse_proxy auth:4001
	}

	@core {
		path /api/customers* /api/products* /api/plans* /api/payments* /api/adjustments* /api/settings
	}
	handle @core {
		reverse_proxy core:4002
	}
	@engagement {
		path /api/messages* /api/notifications* /api/audit* /api/cron*
	}
	handle @engagement {
		reverse_proxy engagement:4003
	}
	handle /api/health {
		reverse_proxy auth:4001
	}
	handle {
		reverse_proxy auth:4001
	}
}
